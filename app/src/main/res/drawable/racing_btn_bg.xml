<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/racing_track" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="@color/racing_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/racing_surface" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="@color/racing_stroke" />
        </shape>
    </item>
</selector>
