<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/tp_primary_edge" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item android:top="3dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tp_primary_dark" />
                    <corners android:radius="18dp" />
                    <stroke android:width="1.5dp" android:color="@color/tp_primary_edge" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/tp_primary_edge" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item android:bottom="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tp_primary_dark" />
                    <corners android:radius="18dp" />
                    <stroke android:width="1.5dp" android:color="@color/tp_primary_edge" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
