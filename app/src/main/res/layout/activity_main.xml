<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:background="#000000">

    <!-- ===================== GAMEPAD SCREEN (hidden until connected) ===================== -->
    <FrameLayout
        android:id="@+id/gamepadRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <com.tombstone.wirelessgamepad.JoystickView
            android:id="@+id/leftStick"
            android:layout_width="150dp"
            android:layout_height="150dp" />

        <com.tombstone.wirelessgamepad.JoystickView
            android:id="@+id/rightStick"
            android:layout_width="150dp"
            android:layout_height="150dp" />

        <com.tombstone.wirelessgamepad.TriggerSliderView
            android:id="@+id/ltSlider"
            android:layout_width="60dp"
            android:layout_height="90dp" />

        <com.tombstone.wirelessgamepad.TriggerSliderView
            android:id="@+id/rtSlider"
            android:layout_width="60dp"
            android:layout_height="90dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/lbBtn"
            android:layout_width="90dp"
            android:layout_height="44dp"
            android:background="@drawable/pill_button_bg"
            android:text="LB"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/rbBtn"
            android:layout_width="90dp"
            android:layout_height="44dp"
            android:background="@drawable/pill_button_bg"
            android:text="RB"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <!-- L3 / R3: styled as small round icon buttons -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/l3Btn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/circle_button_bg"
            android:text="🏃"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/r3Btn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/circle_button_bg"
            android:text="🎯"
            android:textSize="20sp" />

        <!-- Select / Home / Menu trio, top center -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/backBtn"
            android:layout_width="70dp"
            android:layout_height="36dp"
            android:background="@drawable/pill_button_bg"
            android:text="Select"
            android:textAllCaps="false"
            android:textColor="#CCCCCC"
            android:textSize="11sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/homeBtn"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/circle_button_bg"
            android:text="⌂"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/startBtn"
            android:layout_width="70dp"
            android:layout_height="36dp"
            android:background="@drawable/pill_button_bg"
            android:text="☰ Start"
            android:textAllCaps="false"
            android:textColor="#CCCCCC"
            android:textSize="11sp" />

        <!-- D-pad: diamond arrangement, whole group drags as one unit -->
        <RelativeLayout
            android:id="@+id/dpad"
            android:layout_width="160dp"
            android:layout_height="160dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/dUp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerHorizontal="true"
                android:background="@drawable/pill_button_bg"
                android:text="▲"
                android:textColor="#FFFFFF" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/dDown"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/pill_button_bg"
                android:text="▼"
                android:textColor="#FFFFFF" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/dLeft"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerVertical="true"
                android:background="@drawable/pill_button_bg"
                android:text="◀"
                android:textColor="#FFFFFF" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/dRight"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/pill_button_bg"
                android:text="▶"
                android:textColor="#FFFFFF" />
        </RelativeLayout>

        <!-- ABXY: colored circles, whole group drags as one unit -->
        <RelativeLayout
            android:id="@+id/abxy"
            android:layout_width="150dp"
            android:layout_height="150dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnY"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_centerHorizontal="true"
                android:background="@drawable/circle_button_bg"
                android:backgroundTint="#664D3B00"
                android:text="Y"
                android:textColor="#FFC107"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnA"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/circle_button_bg"
                android:backgroundTint="#661B3B1B"
                android:text="A"
                android:textColor="#4CAF50"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnX"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_centerVertical="true"
                android:background="@drawable/circle_button_bg"
                android:backgroundTint="#661B2A3B"
                android:text="X"
                android:textColor="#2196F3"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnB"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/circle_button_bg"
                android:backgroundTint="#663B1B1B"
                android:text="B"
                android:textColor="#F44336"
                android:textStyle="bold" />
        </RelativeLayout>

    </FrameLayout>

    <!-- ===================== CONNECT SCREEN (shown first, hidden after connecting) ===================== -->
    <LinearLayout
        android:id="@+id/connectScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Wireless Gamepad"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/ipInput"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:hint="PC IP e.g. 192.168.137.1"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/connectBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/pill_button_bg"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Connect"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Disconnected"
            android:textColor="#FF5555" />
    </LinearLayout>

</FrameLayout>
