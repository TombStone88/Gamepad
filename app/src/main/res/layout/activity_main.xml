<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- ===================== GAMEPAD SCREEN (hidden until connected) ===================== -->
    <FrameLayout
        android:id="@+id/gamepadRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible">

        <!-- LEFT STICK — large comfortable joystick, left-mid area -->
        <com.tombstone.wirelessgamepad.JoystickView
            android:id="@+id/leftStick"
            android:layout_width="160dp"
            android:layout_height="160dp" />

        <!-- RIGHT STICK — large comfortable joystick, right-mid area -->
        <com.tombstone.wirelessgamepad.JoystickView
            android:id="@+id/rightStick"
            android:layout_width="160dp"
            android:layout_height="160dp" />

        <!-- LT — tall trigger slider, top-left -->
        <com.tombstone.wirelessgamepad.TriggerSliderView
            android:id="@+id/ltSlider"
            android:layout_width="72dp"
            android:layout_height="56dp" />

        <!-- RT — tall trigger slider, top-right -->
        <com.tombstone.wirelessgamepad.TriggerSliderView
            android:id="@+id/rtSlider"
            android:layout_width="72dp"
            android:layout_height="56dp" />

        <!-- LB — shoulder button, top-left below LT -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/lbBtn"
            android:layout_width="88dp"
            android:layout_height="40dp"
            android:background="@drawable/shoulder_button_bg"
            android:letterSpacing="0.05"
            android:text="LB"
            android:textAllCaps="false"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- RB — shoulder button, top-right below RT -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/rbBtn"
            android:layout_width="88dp"
            android:layout_height="40dp"
            android:background="@drawable/shoulder_button_bg"
            android:letterSpacing="0.05"
            android:text="RB"
            android:textAllCaps="false"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- L3 — small round button, bottom-left -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/l3Btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_button_bg"
            android:text="🏃"
            android:textSize="18sp" />

        <!-- R3 — small round button, bottom-right -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/r3Btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_button_bg"
            android:text="🎯"
            android:textSize="18sp" />

        <!-- SELECT — small pill, top-center-left -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/backBtn"
            android:layout_width="64dp"
            android:layout_height="32dp"
            android:background="@drawable/pill_button_bg"
            android:letterSpacing="0.05"
            android:text="SELECT"
            android:textAllCaps="false"
            android:textColor="#AAAAAA"
            android:textSize="9sp" />

        <!-- HOME — circle button, top-center -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/homeBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/circle_button_bg"
            android:text="⌂"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <!-- START — small pill, top-center-right -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/startBtn"
            android:layout_width="64dp"
            android:layout_height="32dp"
            android:background="@drawable/pill_button_bg"
            android:letterSpacing="0.05"
            android:text="START"
            android:textAllCaps="false"
            android:textColor="#AAAAAA"
            android:textSize="9sp" />

        <!-- D-PAD group — cross arrangement of 4 buttons -->
        <RelativeLayout
            android:id="@+id/dpad"
            android:layout_width="156dp"
            android:layout_height="156dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/dUp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/pill_button_bg"
                android:text="▲"
                android:textColor="#CCCCCC"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/dDown"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/pill_button_bg"
                android:text="▼"
                android:textColor="#CCCCCC"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/dLeft"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/pill_button_bg"
                android:text="◀"
                android:textColor="#CCCCCC"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/dRight"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/pill_button_bg"
                android:text="▶"
                android:textColor="#CCCCCC"
                android:textSize="16sp" />
        </RelativeLayout>

        <!-- ABXY group — diamond arrangement -->
        <RelativeLayout
            android:id="@+id/abxy"
            android:layout_width="156dp"
            android:layout_height="156dp">

            <!-- Y — top center -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnY"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_y_bg"
                android:text="Y"
                android:textColor="#FFC107"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- A — bottom center -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnA"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_a_bg"
                android:text="A"
                android:textColor="#4CAF50"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- X — left center -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnX"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_x_bg"
                android:text="X"
                android:textColor="#2196F3"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- B — right center -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnB"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_b_bg"
                android:text="B"
                android:textColor="#F44336"
                android:textSize="15sp"
                android:textStyle="bold" />
        </RelativeLayout>


        <!-- ===================== RACING MODE (covers the gamepad controls; hidden by default) ===================== -->
        <FrameLayout
            android:id="@+id/racingRoot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/racing_bg"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <!-- Top bar: back, mode, gear down / up, recenter, options -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_gravity="top"
                android:background="@color/racing_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/racingBackBtn"
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:minWidth="0dp" android:minHeight="0dp" android:textAllCaps="false" android:background="@drawable/racing_btn_bg" android:textColor="@color/racing_text"
                    android:text="←" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/racingModeBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:minWidth="0dp" android:minHeight="0dp" android:textAllCaps="false" android:background="@drawable/racing_btn_bg" android:textColor="@color/racing_text"
                    android:text="Mode: Wheel" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/racingGearDown"
                    android:layout_width="104dp"
                    android:layout_height="44dp"
                    android:minWidth="0dp" android:minHeight="0dp" android:textAllCaps="false" android:background="@drawable/racing_btn_bg" android:textColor="@color/racing_text"
                    android:text="▼ Gear" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/racingGearUp"
                    android:layout_width="104dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:minWidth="0dp" android:minHeight="0dp" android:textAllCaps="false" android:background="@drawable/racing_btn_bg" android:textColor="@color/racing_text"
                    android:text="▲ Gear" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/racingRecenterBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:visibility="gone"
                    android:minWidth="0dp" android:minHeight="0dp" android:textAllCaps="false" android:background="@drawable/racing_btn_bg" android:textColor="@color/racing_text"
                    android:text="Center" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/racingSettingsBtn"
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp" android:minHeight="0dp" android:textAllCaps="false" android:background="@drawable/racing_btn_bg" android:textColor="@color/racing_text"
                    android:text="⚙" />
            </LinearLayout>

            <!-- Layout 1: wheel on the left, brake + gas on the right -->
            <FrameLayout
                android:id="@+id/racingWheelLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="56dp">

                <com.tombstone.wirelessgamepad.SteeringWheelView
                    android:id="@+id/racingWheel"
                    android:layout_width="230dp"
                    android:layout_height="230dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="48dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:orientation="horizontal"
                    android:paddingBottom="14dp"
                    android:paddingEnd="26dp"
                    android:paddingStart="8dp"
                    android:paddingTop="14dp">

                    <com.tombstone.wirelessgamepad.PedalView
                        android:id="@+id/wheelBrake"
                        android:layout_width="90dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="14dp"
                        android:layout_marginTop="70dp"
                        android:contentDescription="Brake pedal" />

                    <com.tombstone.wirelessgamepad.PedalView
                        android:id="@+id/wheelGas"
                        android:layout_width="120dp"
                        android:layout_height="match_parent"
                        android:contentDescription="Gas pedal" />
                </LinearLayout>
            </FrameLayout>

            <!-- Layout 2: tilt steering, big brake on the left, big gas on the right -->
            <LinearLayout
                android:id="@+id/racingTiltLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="56dp"
                android:orientation="horizontal"
                android:paddingBottom="14dp"
                android:paddingEnd="26dp"
                android:paddingStart="26dp"
                android:paddingTop="14dp"
                android:visibility="gone">

                <com.tombstone.wirelessgamepad.PedalView
                    android:id="@+id/tiltBrake"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Brake pedal" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.3"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tilt to steer"
                        android:textColor="@color/racing_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.tombstone.wirelessgamepad.SteerBarView
                        android:id="@+id/racingSteerBar"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Hold the phone like a wheel.\nTap Center to set your straight-ahead position."
                        android:textColor="@color/racing_text_dim"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.tombstone.wirelessgamepad.PedalView
                    android:id="@+id/tiltGas"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Gas pedal" />
            </LinearLayout>
        </FrameLayout>

    </FrameLayout>

    <!-- ===================== HOME SCREEN (the real first screen the app opens on) ===================== -->
    <LinearLayout
        android:id="@+id/homeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="VGamepad"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/homeConnectBtn"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/pill_button_bg"
            android:text="Connect"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/homeGamepadBtn"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/pill_button_bg"
            android:text="Gamepad"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/homeSettingsBtn"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:background="@drawable/pill_button_bg"
            android:text="Settings"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- ===================== CONNECT SCREEN ===================== -->
    <LinearLayout
        android:id="@+id/connectScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:orientation="vertical">

        <!-- Simple top bar so the app has real chrome, like any other app -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/connectHomeBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/circle_button_bg"
                android:text="←"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Wireless Gamepad"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/settingsBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/circle_button_bg"
                android:text="⚙"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Centered connect form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/findPcBtn"
                android:layout_width="220dp"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/pill_button_bg"
                android:text="🔍 Find PC"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/orDivider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="or enter IP manually"
                android:textColor="#888888"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/ipInput"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:hint="PC IP e.g. 192.168.137.1"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/connectBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/pill_button_bg"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="Connect"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Disconnected"
                android:textColor="#FF5555" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
